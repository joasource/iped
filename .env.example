# Copie para .env e ajuste. Lido pelo docker compose para montar o docker-compose.yml.

IPED_IMAGE=joaca/iped:latest

# Pastas do host (use SSD para IPEDTMP e HASHESDB)
EVIDENCIAS=/mnt/evidences
SAIDA=~/output
IPEDTMP=~/ipedtmp
HASHESDB=~/hashesdb
PLUGINS=~/iped-plugins
LOGS=~/ipedlog
HF_CACHE=~/.cache/huggingface/hub

# Serve no Linux nativo e no WSLg. Se no WSL /tmp/.X11-unix estiver vazio, use /mnt/wslg/.X11-unix
X11_SOCKET=/tmp/.X11-unix

# Rodar como o seu usuario (saida com o seu dono). Vazio = root.
USERID=1000

# Copia o iped-hashes.db para o IPEDTMP antes de processar (hashesdb em rede/disco lento)
HASHESDBONTMP=false
