# Copie para iped.env. Cada linha vira uma variavel iped_* no container
# (o entrypoint.sh aplica nos arquivos de configuracao do IPED).
# Descomente e preencha so o que quiser mudar: variavel vazia = valor padrao do IPED.
# Lista conforme o README, secao "Configuracoes Avancadas".

# --- LocalConfig.txt ---
#iped_locale=
#iped_indexTemp=
#iped_indexTempOnSSD=
#iped_outputOnSSD=
#iped_numThreads=16
#iped_hashesDB=/mnt/hashesdb/iped-hashes_ios.db
#iped_tskJarPath=
#iped_mplayerPath=
#iped_pluginFolder=
#iped_regripperFolder=

# --- IPEDConfig.txt (modulos de processamento) ---
#iped_enableHash=
#iped_enablePhotoDNA=
#iped_enableHashDBLookup=true
#iped_enablePhotoDNALookup=
#iped_enableLedDie=
#iped_enableYahooNSFWDetection=
#iped_enableQRCode=
#iped_ignoreDuplicates=
#iped_exportFileProps=
#iped_processFileSignatures=
#iped_enableFileParsing=
#iped_expandContainers=
#iped_processEmbeddedDisks=
#iped_enableRegexSearch=
#iped_enableAutomaticExportFiles=
#iped_enableLanguageDetect=
#iped_enableNamedEntityRecogniton=
#iped_enableGraphGeneration=
#iped_entropyTest=
#iped_enableSplitLargeBinary=
#iped_indexFileContents=
#iped_enableIndexToElasticSearch=
#iped_enableMinIO=
#iped_enableAudioTranscription=true
#iped_enableCarving=
#iped_enableLedCarving=
#iped_enableKnownMetCarving=
#iped_enableImageThumbs=
#iped_enableImageSimilarity=
#iped_enableFaceRecognition=true
#iped_enableVideoThumbs=
#iped_enableDocThumbs=
#iped_enableHTMLReport=
#iped_enableOCR=true

